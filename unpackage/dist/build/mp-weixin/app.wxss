view{width:100%;box-sizing:border-box;font-family:PingFang SC,PingFang SC}page{width:100%;min-height:100%}.dialog{position:fixed;width:100%;height:100vh;left:0;top:0;z-index:100;background:rgba(0,0,0,.3);display:flex;justify-content:center;align-items:center}.dialog .content{width:128px;height:100px;background:#fff;box-shadow:0 6px 20px rgba(0,22,65,.1);border-radius:8px;display:flex;justify-content:center;align-items:center;flex-direction:column}.dialog .content image{width:32px;height:32px}.dialog .content view{width:128px;font-family:PingFang SC,PingFang SC;font-weight:400;font-size:15px;color:#17181a;line-height:20px;margin-top:10px;text-align:center}
page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}