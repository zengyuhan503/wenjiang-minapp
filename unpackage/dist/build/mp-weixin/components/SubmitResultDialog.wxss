.dialog{position:fixed;width:100%;height:100vh;left:0;top:0;z-index:100;background:rgba(0,0,0,.3);display:flex;justify-content:center;align-items:center}.dialog .content{width:128px;height:100px;background:#fff;box-shadow:0 6px 20px rgba(0,22,65,.1);border-radius:8px;display:flex;justify-content:center;align-items:center;flex-direction:column}.dialog .content image{width:32px;height:32px}.dialog .content view{width:128px;font-family:PingFang SC,PingFang SC;font-weight:400;font-size:15px;color:#17181a;line-height:20px;margin-top:10px;text-align:center}
